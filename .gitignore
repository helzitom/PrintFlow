@'
# .NET
**/bin/
**/obj/
.vs/
*.user
*.suo

# Node.js
node_modules/
dist/
.env
.env.*
!.env.example

# React Native / Expo
.expo/
web-build/

# IDE
.idea/
.vscode/*
!.vscode/
!.vscode/settings.json

# Configuración local y secretos
**/appsettings.Development.json
**/appsettings.Local.json
**/secrets.json

# Logs
*.log

# Archivos temporales
temp/
tmp/

# Documentos recibidos de clientes
storage/
pedidos/
uploads/

# Sistema operativo
Thumbs.db
.DS_Store

# Información privada del proyecto
requisitos.txt
'@ | Set-Content ..\.gitignore -Encoding utf8